# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# Anthropic API key used for the Claude reply loop.
ANTHROPIC_API_KEY=

# Optional overrides.
# ANTHROPIC_MODEL=claude-sonnet-5
# SPECTRUM_PROVIDER=terminal

# Jev scores TikTok evidence for npm run verify and npm run signals (run by hand).
# JEV_API_KEY=


# The number people text (the Photon line), used on the Haps contact card. E.g. +15551234567
HAPS_PHONE_NUMBER=

# Transcribes voice notes so Haps can answer them.
# DEEPGRAM_API_KEY=

# Web search for places (bars, restaurants) that are not parties.
# EXA_API_KEY=

# TikTok promo videos for search_events, through Monid (https://monid.ai).
# MONID_API_KEY=
