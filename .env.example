# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# Anthropic API key used for the Claude reply loop.
ANTHROPIC_API_KEY=

# Optional overrides.
# ANTHROPIC_MODEL=claude-sonnet-5
# SPECTRUM_PROVIDER=terminal

# Jev scores TikTok evidence for npm run verify and npm run signals, and checks a rec's
# website match before Haps sends it as a card.
# JEV_API_KEY=

# Transcribes voice notes so Haps can answer them.
# DEEPGRAM_API_KEY=

# Web search for places (bars, restaurants) that are not parties.
# EXA_API_KEY=

# TikTok promo videos for search_events, through Monid (https://monid.ai).
# MONID_API_KEY=
# Gemini watches Instagram reels (video and audio) to save the spots in them.
# GEMINI_API_KEY=
